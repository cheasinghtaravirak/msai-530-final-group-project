# Do not edit by hand for a first setup. Run:  python scripts/gen_env.py
# It copies this file to .env and fills in fresh secrets and JWT keys.

DEBUG=1
LOG_LEVEL=INFO
DJANGO_SECRET_KEY=change-me
# Shared secret for service-to-service calls (/internal/* endpoints)
SERVICE_TOKEN=change-me

# RS256 key pair, base64-encoded PEM. Only the admin service gets the private key.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# PostgreSQL. Passwords only apply when the postgres volume is first created.
POSTGRES_PASSWORD=postgres
ADMIN_DB_PASSWORD=admin
CATALOG_DB_PASSWORD=catalog
INVENTORY_DB_PASSWORD=inventory
ORDER_DB_PASSWORD=order
ANALYTICS_DB_PASSWORD=analytics

# Demo HQ admin created on first start of the admin service
BOOTSTRAP_ADMIN_EMAIL=hq@demo.local
BOOTSTRAP_ADMIN_PASSWORD=demo1234

# Local LLM (Ollama runs on the host machine, not in Docker)
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
